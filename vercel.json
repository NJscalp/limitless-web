{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/v1/face-analyze-full", "destination": "/api/face-analyze" },
    { "source": "/v1/face-refine", "destination": "/api/face-refine" },
    { "source": "/v1/arkit-mesh", "destination": "/api/arkit-mesh-upload" },
    { "source": "/v1/arkit-mesh.json", "destination": "/api/arkit-mesh" },
    { "source": "/v1/glow-up-analyze", "destination": "/api/glow-up-analyze" },
    { "source": "/v1/kie/future-self", "destination": "/api/kie/future-self" },
    { "source": "/v1/kie/tasks/:taskId", "destination": "/api/kie/tasks/:taskId" },
    { "source": "/v1/seedance/reference-to-video", "destination": "/api/seedance/submit" },
    { "source": "/v1/seedance/status", "destination": "/api/seedance/status" },
    { "source": "/v1/fruit-story/plan", "destination": "/api/seedance/fruitplan" },
    { "source": "/v1/fruit-story/animate", "destination": "/api/seedance/submit" },
    { "source": "/v1/fruit-story/status", "destination": "/api/seedance/status" },
    { "source": "/v1/gpt-image/edit", "destination": "/api/gpt-image/submit" },
    { "source": "/v1/gpt-image/status", "destination": "/api/gpt-image/status" },
    { "source": "/v1/upscale/submit", "destination": "/api/upscale/submit" },
    { "source": "/v1/upscale/status", "destination": "/api/upscale/status" },
    { "source": "/v1/lipsync/submit", "destination": "/api/upscale/submit" },
    { "source": "/v1/lipsync/status", "destination": "/api/upscale/status" },
    { "source": "/health", "destination": "/api/health" }
  ],
  "functions": {
    "api/face-analyze.mjs": { "maxDuration": 60 },
    "api/face-refine.mjs": { "maxDuration": 60 },
    "api/face-landmarks.mjs": { "maxDuration": 30 },
    "api/arkit-mesh.mjs": { "maxDuration": 15 },
    "api/arkit-mesh-upload.mjs": { "maxDuration": 30 },
    "api/glow-up-analyze.mjs": { "maxDuration": 60 },
    "api/kie/future-self.mjs": { "maxDuration": 300 },
    "api/kie/tasks/[taskId].mjs": { "maxDuration": 30 },
    "api/seedance/[action].mjs": { "maxDuration": 60 },
    "api/gpt-image/[action].mjs": { "maxDuration": 60 },
    "api/upscale/[action].mjs": { "maxDuration": 60 },
    "api/health.mjs": { "maxDuration": 10 }
  }
}
